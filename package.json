{
  "name": "music-agent-harness",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "main": "apps/companion/main.cjs",
  "description": "A content-free developmental recurrence harness for one continuing subject.",
  "exports": {
    ".": "./src/index.js",
    "./companion": "./src/companion.js",
    "./rehearsal": "./src/rehearsal.js"
  },
  "bin": {
    "music": "./src/cli.js",
    "music-doctor": "./bin/music-doctor.js",
    "music-install": "./bin/music-install.js",
    "music-verify-hosted-selector": "./bin/music-verify-hosted-selector.js"
  },
  "files": [
    "src/",
    "bin/",
    "apps/companion/",
    "LICENSE",
    "README.md",
    "DESIGN.md",
    "HATCH.md",
    "READINESS.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/*.js bin/*.js apps/companion/*.js apps/companion/*.cjs && node --test",
    "companion": "electron apps/companion/main.cjs",
    "companion:package": "electron-packager . \"Music Companion\" --platform=darwin --arch=arm64 --overwrite --out=dist --app-bundle-id=com.x3haloed.music.companion --prune=true --ignore='^/(?:\\.git|\\.codex|test|dist|\\.music)(?:/|$)'",
    "rehearse": "node src/cli.js rehearse",
    "verify:hosted-selector": "node bin/music-verify-hosted-selector.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.85",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^42.11.1"
  }
}
